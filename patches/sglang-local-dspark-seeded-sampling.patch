index 0000000..dc39c0b
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/dspark/seeded_draws.py
@@ -0,0 +1,72 @@
+"""Seeded random draws for DSpark speculative decoding.
+
+When the server runs with --enable-deterministic-inference, every request
+carries a sampling seed (SamplingBatchInfo.sampling_seed, default 42). The
+EAGLE verify path then derives its coins from murmur_hash32(seed, seq_len,
+column) (eagle_utils._seeded_verify_coins). This module gives the DSpark
+draft sampler the same kind of draw: exponential noise for the
+Gumbel-max / exponential-race sampler SampleStepTokens (key = prob / noise),
+derived from the request seed, the request prefix length and the draft step.
+
+The draft seed is XOR-salted so the draft noise never reuses the hash stream
+of the verify coins or of the main sampler for the same (seed, position).
+"""
+
+from __future__ import annotations
+
+import torch
+
+# XOR salt applied to the request seed for draft noise (an odd 64-bit
+# constant below 2**63, so the salted seed stays a valid int64).
+DRAFT_NOISE_SEED_SALT = 0x2545F4914F6CDD1D
+
+# The hashed position of draft step s in a round whose prefix length is L is
+# L * DRAFT_NOISE_STEPS_PER_POSITION + s, unique per (round, step) while the
+# draft block length gamma stays below this value.
+DRAFT_NOISE_STEPS_PER_POSITION = 64
+
+# Largest float32 below 1.0: a uniform of exactly 1.0 would give noise 0 and
+# an infinite SampleStepTokens key, so uniforms are clamped to this value.
+_MAX_UNIFORM = 1.0 - 2**-24
+
+
+def draft_noise_seeds(sampling_seed: torch.Tensor) -> torch.Tensor:
+    """Salted per-request seeds (int64, shape (bs,)) for the draft noise."""
+    assert sampling_seed.dim() == 1, f"{sampling_seed.shape=}"
+    return sampling_seed.to(torch.int64) ^ DRAFT_NOISE_SEED_SALT
+
+
+def draft_noise_positions(prefix_lens: torch.Tensor, step: int) -> torch.Tensor:
+    """Hashed positions (int64, shape (bs,)) for draft step `step` of a round
+    whose per-request prefix lengths are `prefix_lens`."""
+    assert prefix_lens.dim() == 1, f"{prefix_lens.shape=}"
+    assert 0 <= step < DRAFT_NOISE_STEPS_PER_POSITION, f"{step=}"
+    return prefix_lens.to(torch.int64) * DRAFT_NOISE_STEPS_PER_POSITION + step
+
+
+def fill_seeded_exp_noise(
+    *,
+    out: torch.Tensor,
+    seeds: torch.Tensor,
+    positions: torch.Tensor,
+    cols: torch.Tensor,
+) -> torch.Tensor:
+    """Fill `out` (float32, shape (bs, V)) with Exp(1) noise derived from
+    murmur_hash32(seeds, positions, cols), in place, and return it.
+
+    The uniform is hashed / uint32_max, as in eagle_utils._seeded_verify_coins,
+    clamped to the largest float32 below 1.0; the noise is -log(uniform),
+    which lies in (0, +inf]. A uniform of 0 gives noise +inf and key 0, which
+    only removes that one token from the race.
+    """
+    from sglang.kernels.ops.sampling.murmur_hash import murmur_hash32
+
+    assert out.dim() == 2 and out.dtype == torch.float32, f"{out.shape=} {out.dtype=}"
+    bs, vocab = out.shape
+    assert seeds.shape == (bs,), f"{seeds.shape=} {bs=}"
+    assert positions.shape == (bs,), f"{positions.shape=} {bs=}"
+    assert cols.shape == (vocab,), f"{cols.shape=} {vocab=}"
+    hashed = murmur_hash32(seeds.to(torch.uint64), positions.to(torch.uint64), cols)
+    out.copy_(hashed.to(torch.float64) / torch.iinfo(torch.uint32).max)
+    out.clamp_(max=_MAX_UNIFORM).log_().neg_()
+    return out
