+++ b/python/sglang/srt/mem_cache/swa_radix_cache.py
@@ -373,7 +373,7 @@ class SWARadixCache(BasePrefixCache):
         )
         return True
 
-    def swa_reprefill_tail_tokens(self) -> int:
+    def swa_reprefill_tail_tokens(self, req=None) -> int:
         """Tokens at the tail of a matched prefix that must NOT be reused.
 
         The DeepSeek-V4 unified_kv layout keeps SWA in a per-request ring
diff --git a/python/sglang/srt/mem_cache/unified_radix_cache.py b/python/sglang/srt/mem_cache/unified_radix_cache.py
index e2d4b5e8b5..859d0ca001 100644
--- a/python/sglang/srt/mem_cache/unified_radix_cache.py
+++ b/python/sglang/srt/mem_cache/unified_radix_cache.py
@@ -201,6 +201,7 @@ class UnifiedRadixCache(BasePrefixCache):
         self._sliding_window_size = (
             params.sliding_window_size if self.is_swa_enabled else None
         )
+        self.decoder_swa_bounded_replay = params.decoder_swa_bounded_replay
         # The TreeCore owns the tree member-var state (structure, LRUs, sizes,
