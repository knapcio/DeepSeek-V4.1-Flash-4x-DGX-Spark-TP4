         self._tree_core_backend = envs.SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND.get()
@@ -3383,7 +3384,7 @@ class UnifiedRadixCache(BasePrefixCache):
     def sliding_window_size(self):
         return self._sliding_window_size
 
-    def swa_reprefill_tail_tokens(self) -> int:
+    def swa_reprefill_tail_tokens(self, req=None) -> int:
         """
         Only unified_kv needs this: SWA lives in a per-request ring
         (state_slot/pos), not content-stable and never stored in the tree, so a
@@ -3402,6 +3403,8 @@ class UnifiedRadixCache(BasePrefixCache):
         swa = self.components.get(ComponentType.SWA)
         if swa is None or not swa.sliding_window_size:
             return 0
+        if self.decoder_swa_bounded_replay and not self.session.will_lend_record(req):
+            return swa.sliding_window_size
         if not is_unified_kv_triton():
             return 0
         if self.tree_core.has_swa_host_pool:
diff --git a/python/sglang/srt/session/streaming_session.py b/python/sglang/srt/session/streaming_session.py
index 96ec95f764..1a7df90cff 100644
--- a/python/sglang/srt/session/streaming_session.py
+++ b/python/sglang/srt/session/streaming_session.py
@@ -103,6 +103,13 @@ class StreamingSession(BasePrefixCache):
         self.inner = inner
         self.slots: Dict[str, SessionSlot] = {}
 
+    def will_lend_record(self, req: Optional[Req]) -> bool:
+        """Whether req has a slot record to borrow without mutating session state."""
+        if not _is_streaming(req) or req.to_finish is not None:
+            return False
+        slot = self.slots.get(req.session.session_id)
+        return slot is not None and slot.kv.holds_kv
+
     # -- Forward PrefixCacheTrait properties to inner cache --
 
     @property
